DEPLOY_AGENT_IMAGE=vatai12/worker-cabinet-deployment-agent:VERSION
DEPLOY_ROLE=backend
DEPLOY_ROOT=/root
DEPLOY_PROJECT=root
DEPLOY_COMPOSE_FILE=/root/docker-compose.yml
DEPLOY_APP_ENV_FILE=/root/.env
DEPLOY_BACKUP_DIR=/root/backups
DEPLOY_NETWORK=root_worker-cabinet-network
DEPLOY_BACKEND_REPOSITORY=vatai12/worker-cabinet-backend
DEPLOY_FRONTEND_REPOSITORY=vatai12/worker-cabinet-frontend
DEPLOY_PLATFORM=linux/amd64
DEPLOY_REGISTRY_URL=https://registry-1.docker.io
DEPLOY_REGISTRY_USERNAME=
DEPLOY_REGISTRY_PASSWORD=
DEPLOY_REGISTRY_ALLOW_HTTP=false
DEPLOY_REGISTRY_POLL_SECONDS=30
DEPLOY_REGISTRY_AUTH_ORIGINS=
DEPLOY_SSH_TARGET=wc-deploy@10.20.192.17
DEPLOY_SSH_PORT=22
DEPLOY_SSH_KEY=/run/deploy-ssh/id_ed25519
DEPLOY_SSH_KNOWN_HOSTS=/run/deploy-ssh/known_hosts
DB_HOST=postgres
DB_PORT=5432
DB_NAME=worker_cabinet
DB_USER=postgres
DB_PASSWORD=REPLACE_ON_SERVER
DB_SSL=false
