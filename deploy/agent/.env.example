DEPLOY_ROOT=/opt/worker-cabinet
DEPLOY_HOST_CONFIG=/etc/worker-cabinet/backend-deploy.json
DEPLOY_RELEASES_FILE=/opt/worker-cabinet/releases/index.json
DEPLOY_FRONTEND_REPOSITORY=vatai12/worker-cabinet-frontend
DEPLOY_SSH_TARGET=wc-deploy@frontend.example.ru
DEPLOY_SSH_KEY=/run/deploy-ssh/id_ed25519
DEPLOY_SSH_KNOWN_HOSTS=/run/deploy-ssh/known_hosts
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=worker_cabinet
DB_USER=postgres
DB_PASSWORD=REPLACE_ON_SERVER
DB_SSL=false
