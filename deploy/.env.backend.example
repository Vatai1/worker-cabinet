REGISTRY=registry.example.com
BACKEND_IMAGE=worker-cabinet-backend:latest

DB_NAME=worker_cabinet
DB_USER=postgres
DB_PASSWORD=PLACEHOLDER_PASSWORD
DB_PORT=5432
JWT_SECRET=PLACEHOLDER_JWT_SECRET

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=PLACEHOLDER_S3_SECRET
S3_BUCKET=worker-cabinet
S3_PUBLIC_URL=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

ONLYOFFICE_JWT_ENABLED=true
ONLYOFFICE_JWT_SECRET=PLACEHOLDER_OO_JWT_SECRET

BACKEND_PORT=5000

MAIL_HOST=smtp.yandex.ru
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=noreply@example.ru
MAIL_PASSWORD=PLACEHOLDER_APP_PASSWORD
MAIL_FROM='"Личный кабинет работника" <noreply@example.ru>'
MAIL_RATE_PER_MINUTE=20

HERMES_API_KEY=PLACEHOLDER_HERMES_KEY
HERMES_PORT=8642
SEARXNG_PORT=8888

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_URL=localhost
KEYCLOAK_PORT=8081
KEYCLOAK_REALM=worker-cabinet
KEYCLOAK_CLIENT_ID=worker-cabinet
KEYCLOAK_CLIENT_SECRET=PLACEHOLDER_SECRET
KEYCLOAK_DB_PASSWORD=PLACEHOLDER_PASSWORD
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=PLACEHOLDER_PASSWORD
